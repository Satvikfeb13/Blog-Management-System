<nav class="navbar navbar-expand-lg border-bottom">
    <div class="container">
        <!-- Brand -->
        <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" asp-controller="Post" asp-action="Index">
            <i class="fas fa-blog"></i> BlogApp
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarMain"
                aria-controls="navbarMain"
                aria-expanded="false"
                aria-label="Toggle navigation" style="border:none; outline:none;">
            <i class="fas fa-bars"></i>
        </button>

        <!-- Navbar Content -->
        <div class="collapse navbar-collapse" id="navbarMain">
            <!-- Left Side Menu -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Post" asp-action="Index">
                        <i class="fas fa-home me-1"></i> Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/#categories">
                        <i class="fas fa-list me-1"></i> Categories
                    </a>
                </li>
            </ul>

            <!-- Right Side Buttons -->
            <div class="d-flex align-items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-medium text-white me-2">
                            <i class="fas fa-user-circle me-1"></i> @(User.Identity.Name)
                        </span>
                        <a class="btn btn-outline-info rounded-pill px-3 shadow-sm" asp-controller="Post" asp-action="MyBlogs">
                            <i class="fas fa-edit me-1"></i> My Blogs
                        </a>
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-primary rounded-pill px-3 dropdown-toggle" type="button" id="adminMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-tachometer-alt me-1"></i> Admin
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end glass-card" aria-labelledby="adminMenu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="fas fa-chart-line me-2"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="PendingPosts"><i class="fas fa-clock me-2"></i>Pending Submissions</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="ReportedComments"><i class="fas fa-flag me-2"></i>Reported Comments</a></li>
                                </ul>
                            </div>
                        }
                        
                        <a class="btn btn-danger rounded-pill px-3 shadow-sm" asp-controller="Auth" asp-action="Logout">
                            <i class="fas fa-sign-out-alt me-1"></i> Logout
                        </a>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary rounded-pill px-4">
                        Login
                    </a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        Register
                    </a>
                }
            </div>
        </div>
    </div>
</nav>