@{
    ViewData["Title"] = "Admin Dashboard";
    var recentPosts = ViewBag.RecentPosts as IEnumerable<BlogApp.Models.Post>;
    var recentComments = ViewBag.RecentComments as IEnumerable<BlogApp.Models.Comment>;
}

<div class="container-fluid mt-4" data-aos="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</h2>
        <div>
            <a asp-controller="Post" asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i> New Post</a>
        </div>
    </div>

    <!-- Blog Status Cards -->
    <h5 class="fw-bold mb-3 text-secondary">Blog Submissions</h5>
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <a asp-action="PendingPosts" class="text-decoration-none">
                <div class="card glass-card border-0 bg-warning bg-opacity-10 h-100">
                    <div class="card-body p-3 text-center d-flex flex-column justify-content-center">
                        <div class="mb-2"><i class="fas fa-clock fs-3 text-warning"></i></div>
                        <h2 class="fw-bold text-warning mb-1">@ViewBag.PendingBlogs</h2>
                        <p class="text-muted mb-0 small fw-medium text-uppercase tracking-wide">Pending Review</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <div class="card glass-card border-0 bg-success bg-opacity-10 h-100">
                <div class="card-body p-3 text-center d-flex flex-column justify-content-center">
                    <div class="mb-2"><i class="fas fa-check-circle fs-3 text-success"></i></div>
                    <h2 class="fw-bold text-success mb-1">@ViewBag.PublishedBlogs</h2>
                    <p class="text-muted mb-0 small fw-medium text-uppercase tracking-wide">Published Blogs</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card glass-card border-0 bg-danger bg-opacity-10 h-100">
                <div class="card-body p-3 text-center d-flex flex-column justify-content-center">
                    <div class="mb-2"><i class="fas fa-times-circle fs-3 text-danger"></i></div>
                    <h2 class="fw-bold text-danger mb-1">@ViewBag.RejectedBlogs</h2>
                    <p class="text-muted mb-0 small fw-medium text-uppercase tracking-wide">Rejected Blogs</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card glass-card border-0 bg-secondary bg-opacity-10 h-100">
                <div class="card-body p-3 text-center d-flex flex-column justify-content-center">
                    <div class="mb-2"><i class="fas fa-file-alt fs-3 text-secondary"></i></div>
                    <h2 class="fw-bold text-secondary mb-1">@ViewBag.DraftBlogs</h2>
                    <p class="text-muted mb-0 small fw-medium text-uppercase tracking-wide">Draft Blogs</p>
                </div>
            </div>
        </div>
    </div>

    <h5 class="fw-bold mb-3 text-secondary">Platform Overview</h5>
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card glass-card border-0 bg-primary bg-opacity-10 h-100">
                <div class="card-body p-3 text-center d-flex flex-column justify-content-center">
                    <div class="mb-2"><i class="fas fa-users fs-3 text-primary"></i></div>
                    <h2 class="fw-bold text-primary mb-1">@ViewBag.TotalUsers</h2>
                    <p class="text-muted mb-0 small fw-medium text-uppercase tracking-wide">Total Users</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card glass-card border-0 bg-info bg-opacity-10 h-100">
                <div class="card-body p-3 text-center d-flex flex-column justify-content-center">
                    <div class="mb-2"><i class="fas fa-folder fs-3 text-info"></i></div>
                    <h2 class="fw-bold text-info mb-1">@ViewBag.TotalCategories</h2>
                    <p class="text-muted mb-0 small fw-medium text-uppercase tracking-wide">Categories</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card glass-card border-0 bg-light bg-opacity-10 h-100">
                <div class="card-body p-3 text-center d-flex flex-column justify-content-center">
                    <div class="mb-2"><i class="fas fa-comments fs-3 text-light"></i></div>
                    <h2 class="fw-bold text-light mb-1">@ViewBag.TotalComments</h2>
                    <p class="text-muted mb-0 small fw-medium text-uppercase tracking-wide">Total Comments</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Posts -->
        <div class="col-lg-8">
            <div class="card glass-card border-0 h-100">
                <div class="card-header bg-transparent border-bottom p-4">
                    <h5 class="fw-bold mb-0">Recent Posts</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Title</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Views</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (recentPosts != null && recentPosts.Any())
                                {
                                    @foreach (var post in recentPosts)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <a asp-controller="Post" asp-action="Detail" asp-route-id="@post.Id" class="text-decoration-none fw-medium" style="color: var(--text);">
                                                    @post.Title
                                                </a>
                                            </td>
                                            <td>
                                                @if(post.Status == BlogApp.Models.Enums.PostStatus.Published)
                                                {
                                                    <span class="badge bg-success">Published</span>
                                                }
                                                else if (post.Status == BlogApp.Models.Enums.PostStatus.PendingReview)
                                                {
                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                }
                                                else if (post.Status == BlogApp.Models.Enums.PostStatus.Rejected)
                                                {
                                                    <span class="badge bg-danger">Rejected</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Draft</span>
                                                }
                                            </td>
                                            <td class="text-muted small">@post.PublishedDate.ToString("MMM dd, yyyy")</td>
                                            <td><i class="far fa-eye text-muted me-1"></i>@post.ViewCount</td>
                                            <td class="text-end pe-4">
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-controller="Post" asp-action="Edit" asp-route-id="@post.Id" class="btn btn-outline-primary"><i class="fas fa-edit"></i></a>
                                                    <a asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" class="btn btn-outline-danger"><i class="fas fa-trash"></i></a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">No recent posts found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Comments -->
        <div class="col-lg-4">
            <div class="card glass-card border-0 h-100">
                <div class="card-header bg-transparent border-bottom p-4">
                    <h5 class="fw-bold mb-0">Recent Comments</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush border-0">
                        @if (recentComments != null && recentComments.Any())
                        {
                            @foreach (var comment in recentComments)
                            {
                                <div class="list-group-item p-3 bg-transparent border-bottom border-light border-opacity-10">
                                    <div class="d-flex w-100 justify-content-between mb-1">
                                        <h6 class="mb-0 fw-bold text-white">@comment.UserName</h6>
                                        <small class="text-muted">@comment.CommentDate.ToString("MMM dd")</small>
                                    </div>
                                    <p class="mb-1 text-secondary small">@comment.Content</p>
                                    <small class="text-primary text-truncate d-block">On: @(comment.Post?.Title.Length > 40 ? comment.Post?.Title.Substring(0, 40) + "..." : comment.Post?.Title)</small>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">No comments found.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
