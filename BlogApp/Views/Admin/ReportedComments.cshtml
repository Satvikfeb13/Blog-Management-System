@model IEnumerable<BlogApp.Models.CommentReport>
@{
    ViewData["Title"] = "Reported Comments";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Reported Comments</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="glass-card text-center p-5">
            <div class="mb-4 text-muted">
                <i class="fas fa-shield-alt fa-3x"></i>
            </div>
            <h4>Clean Slate!</h4>
            <p class="text-secondary">No comments have been reported.</p>
        </div>
    }
    else
    {
        <div class="glass-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-borderless table-hover mb-0 text-white">
                    <thead class="bg-dark bg-opacity-50">
                        <tr>
                            <th class="py-3 px-4">Comment</th>
                            <th class="py-3">Report Details</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model)
                        {
                            <tr class="border-bottom border-light border-opacity-10">
                                <td class="py-3 px-4 align-middle" style="max-width: 300px;">
                                    <div class="fw-medium text-white text-truncate">@report.Comment?.Content</div>
                                    <div class="text-secondary small mt-1">
                                        By @report.Comment?.UserName on <a asp-controller="Post" asp-action="Detail" asp-route-id="@report.Comment?.PostId" class="text-info text-decoration-none">@report.Comment?.Post?.Title</a>
                                    </div>
                                </td>
                                <td class="py-3 align-middle">
                                    <span class="badge bg-warning text-dark mb-1">@report.Reason</span>
                                    @if(!string.IsNullOrEmpty(report.AdditionalDetails))
                                    {
                                        <div class="text-muted small">@report.AdditionalDetails</div>
                                    }
                                    <div class="text-secondary small mt-1">Reported by: @(report.ReportedByUser?.Email ?? "Anonymous")</div>
                                </td>
                                <td class="py-3 align-middle">
                                    @if(report.Comment?.IsHidden == true)
                                    {
                                        <span class="badge bg-secondary"><i class="fas fa-eye-slash me-1"></i> Hidden</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="fas fa-eye me-1"></i> Visible</span>
                                    }
                                </td>
                                <td class="py-3 px-4 align-middle text-end">
                                    @if(report.Comment?.IsHidden == true)
                                    {
                                        <button class="btn btn-sm btn-outline-success rounded-pill px-3 me-1" onclick="restoreComment(@report.CommentId)">
                                            <i class="fas fa-undo me-1"></i> Restore
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-warning rounded-pill px-3 me-1" onclick="hideComment(@report.CommentId)">
                                            <i class="fas fa-eye-slash me-1"></i> Hide
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="deleteComment(@report.CommentId)">
                                        <i class="fas fa-trash me-1"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function hideComment(id) {
            if(confirm("Are you sure you want to hide this comment?")) {
                $.post('/Post/HideComment/' + id, function() {
                    window.location.reload();
                });
            }
        }
        function restoreComment(id) {
            if(confirm("Are you sure you want to restore this comment?")) {
                $.post('/Post/RestoreComment/' + id, function() {
                    window.location.reload();
                });
            }
        }
        function deleteComment(id) {
            if(confirm("Are you sure you want to permanently delete this comment?")) {
                $.post('/Post/DeleteComment/' + id, function() {
                    window.location.reload();
                });
            }
        }
    </script>
}
