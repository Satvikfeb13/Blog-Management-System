@model IEnumerable<BlogApp.Models.Post>
@{
    ViewData["Title"] = "Pending Blog Submissions";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Pending Blog Submissions</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="glass-card text-center p-5">
            <div class="mb-4 text-muted">
                <i class="fas fa-check-circle fa-3x"></i>
            </div>
            <h4>All Caught Up!</h4>
            <p class="text-secondary">There are currently no blog posts waiting for approval.</p>
        </div>
    }
    else
    {
        <div class="glass-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-borderless table-hover mb-0 text-white">
                    <thead class="bg-dark bg-opacity-50">
                        <tr>
                            <th class="py-3 px-4">Post</th>
                            <th class="py-3">Author</th>
                            <th class="py-3">Submitted</th>
                            <th class="py-3 text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model)
                        {
                            <tr class="border-bottom border-light border-opacity-10">
                                <td class="py-3 px-4 align-middle">
                                    <div class="d-flex align-items-center">
                                        <img src="@(string.IsNullOrEmpty(post.FeatureImagePath) ? "/images/default-blog.jpg" : post.FeatureImagePath)" 
                                             class="rounded shadow-sm me-3 object-fit-cover" 
                                             style="width: 50px; height: 50px;" alt="@post.Title">
                                        <div>
                                            <a asp-controller="Post" asp-action="Detail" asp-route-id="@post.Id" class="text-white text-decoration-none fw-bold" target="_blank">@post.Title <i class="fas fa-external-link-alt ms-1 small"></i></a>
                                            <div class="text-muted small mt-1">@post.Category?.Name</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 align-middle">
                                    <div class="fw-medium">@post.Author</div>
                                    <div class="text-secondary small">@(post.CreatedByUser?.Email)</div>
                                </td>
                                <td class="py-3 align-middle text-secondary">
                                    @post.PublishedDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="py-3 px-4 align-middle text-end">
                                    <form asp-action="ApprovePost" method="post" class="d-inline-block me-1">
                                        <input type="hidden" name="id" value="@post.Id" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                            <i class="fas fa-check me-1"></i> Approve
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-danger rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#rejectModal-@post.Id">
                                        <i class="fas fa-times me-1"></i> Reject
                                    </button>

                                    <!-- Reject Modal -->
                                    <div class="modal fade" id="rejectModal-@post.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content glass-card text-start">
                                                <div class="modal-header border-bottom border-light border-opacity-10">
                                                    <h5 class="modal-title">Reject Blog Post</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="RejectPost" method="post">
                                                    <div class="modal-body">
                                                        <input type="hidden" name="id" value="@post.Id" />
                                                        <div class="form-group mb-3">
                                                            <label class="form-label text-white">Reason for Rejection (Optional)</label>
                                                            <textarea name="reason" class="form-control" rows="3" placeholder="Explain why this post is being rejected..."></textarea>
                                                        </div>
                                                        <p class="text-muted small">The author will be able to see this reason, edit their post, and resubmit it.</p>
                                                    </div>
                                                    <div class="modal-footer border-top border-light border-opacity-10">
                                                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Rejection</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
