@using BlogApp.Helper
@model IEnumerable<Post>
@{
    ViewData["Title"] = "Blog Posts";
}

<!-- Hero Section -->
<div class="hero-section" data-aos="fade-down">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">Welcome to BlogApp</h1>
        <p class="lead mb-4">Discover stories, thinking, and expertise from writers on any topic.</p>
        
        <!-- Search and Filter -->
        <div class="row justify-content-center">
            <div class="col-md-8">
                <form asp-controller="Post" asp-action="Index" method="get" class="d-flex gap-2">
                    <input type="text" name="search" list="categorySearchList" class="form-control form-control-lg shadow-sm" placeholder="Search for articles or categories..." autocomplete="off">
                    <datalist id="categorySearchList">
                        @if (ViewBag.Categories != null)
                        {
                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Name"></option>
                            }
                        }
                    </datalist>
                    <button type="submit" class="btn btn-primary btn-lg shadow-sm px-4">Search</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <!-- Categories Filter -->
    <div id="categories" class="d-flex flex-wrap gap-2 justify-content-center mb-5" data-aos="fade-up" style="scroll-margin-top: 100px;">
        <a asp-controller="Post" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 @(Context.Request.Query["categoryId"].Count == 0 ? "active" : "")">All</a>
        @if (ViewBag.Categories != null)
        {
            @foreach (var category in ViewBag.Categories)
            {
                <a asp-controller="Post" asp-action="Index" asp-route-categoryId="@category.Id" class="btn btn-outline-primary rounded-pill px-4 @(Context.Request.Query["categoryId"] == category.Id.ToString() ? "active" : "")">
                    @category.Name
                </a>
            }
        }
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="text-end mb-4" data-aos="fade-left">
            <a class="btn btn-primary shadow-sm" asp-action="Create" asp-controller="Post">
                <i class="fas fa-plus me-2"></i>Create New Post
            </a>
        </div>
    }

    <!-- Blog Posts Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var post in Model)
        {
            <div class="col" data-aos="fade-up" data-aos-delay="100">
                <div class="card h-100 glass-card border-0">
                    <div class="position-relative overflow-hidden" style="border-radius: 16px 16px 0 0;">
                        <img src="@(string.IsNullOrEmpty(post.FeatureImagePath) ? "/images/default-blog.jpg" : post.FeatureImagePath)"
                             class="card-img-top"
                             alt="@post.Title"
                             style="height: 240px; object-fit: cover; transition: transform 0.5s;"
                             onmouseover="this.style.transform='scale(1.05)'"
                             onmouseout="this.style.transform='scale(1)'" />
                        
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge badge-tag px-3 py-2 rounded-pill shadow-sm">
                                <i class="fas fa-folder me-1"></i> @post.Category?.Name
                            </span>
                        </div>
                    </div>

                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3 text-muted small">
                            <span><i class="far fa-calendar-alt me-1"></i> @post.PublishedDate.ToString("MMM dd, yyyy")</span>
                            <span><i class="far fa-clock me-1"></i> @(post.ReadTime > 0 ? post.ReadTime : 5) min read</span>
                        </div>
                        
                        <h5 class="card-title fw-bold mb-3" style="font-size: 1.25rem;">
                            <a asp-action="Detail" asp-controller="Post" asp-route-id="@post.Id" class="text-decoration-none" style="color: var(--text);">
                                @post.Title
                            </a>
                        </h5>

                        @{
                            var content = RemoveHtmlTagHelper.removehtmltag(post.Content);
                            var previewText = content.Length > 120 ? content.Substring(0, 120) + "..." : content;
                        }
                        
                        <p class="card-text text-muted mb-4" style="font-size: 0.95rem; line-height: 1.6;">
                            @Html.Raw(previewText)
                        </p>

                        <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 35px; height: 35px;">
                                    @post.Author.Substring(0, 1).ToUpper()
                                </div>
                                <span class="fw-medium small" style="color: var(--text);">@post.Author</span>
                            </div>
                            <div class="d-flex gap-2 text-muted">
                                <span title="Views"><i class="far fa-eye"></i> @post.ViewCount</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    
    @if (!Model.Any())
    {
        <div class="text-center py-5" data-aos="fade-in">
            <i class="fas fa-folder-open text-muted mb-3" style="font-size: 4rem;"></i>
            <h3 class="text-muted">No posts found.</h3>
            <p class="text-muted">Check back later or try a different category.</p>
        </div>
    }
</div>