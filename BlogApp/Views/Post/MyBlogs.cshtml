@model IEnumerable<BlogApp.Models.Post>
@{
    ViewData["Title"] = "My Blogs";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">My Blogs</h2>
        <a asp-controller="Post" asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="fas fa-plus me-2"></i>Create New Blog
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="glass-card text-center p-5">
            <div class="mb-4 text-muted">
                <i class="fas fa-file-alt fa-3x"></i>
            </div>
            <h4>No Blogs Found</h4>
            <p class="text-secondary">You haven't created any blogs yet.</p>
            <a asp-controller="Post" asp-action="Create" class="btn btn-primary rounded-pill mt-2">Create Your First Blog</a>
        </div>
    }
    else
    {
        <div class="glass-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-borderless table-hover mb-0 text-white">
                    <thead class="bg-dark bg-opacity-50">
                        <tr>
                            <th class="py-3 px-4">Post</th>
                            <th class="py-3">Status</th>
                            <th class="py-3">Created Date</th>
                            <th class="py-3 text-center">Views</th>
                            <th class="py-3 text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model)
                        {
                            <tr class="border-bottom border-light border-opacity-10">
                                <td class="py-3 px-4 align-middle">
                                    <div class="d-flex align-items-center">
                                        <img src="@(string.IsNullOrEmpty(post.FeatureImagePath) ? "/images/default-blog.jpg" : post.FeatureImagePath)" 
                                             class="rounded shadow-sm me-3 object-fit-cover" 
                                             style="width: 50px; height: 50px;" alt="@post.Title">
                                        <div>
                                            <a asp-action="Detail" asp-route-id="@post.Id" class="text-white text-decoration-none fw-bold">@post.Title</a>
                                            <div class="text-muted small mt-1">@post.Category?.Name</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 align-middle">
                                    @if(post.Status == BlogApp.Models.Enums.PostStatus.Draft)
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3">Draft</span>
                                    }
                                    else if(post.Status == BlogApp.Models.Enums.PostStatus.PendingReview)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3">Pending</span>
                                    }
                                    else if(post.Status == BlogApp.Models.Enums.PostStatus.Published)
                                    {
                                        <span class="badge bg-success rounded-pill px-3">Published</span>
                                    }
                                    else if(post.Status == BlogApp.Models.Enums.PostStatus.Rejected)
                                    {
                                        <span class="badge bg-danger rounded-pill px-3">Rejected</span>
                                        @if(!string.IsNullOrEmpty(post.RejectedReason))
                                        {
                                            <div class="small text-danger mt-1">@post.RejectedReason</div>
                                        }
                                    }
                                </td>
                                <td class="py-3 align-middle text-secondary">
                                    @post.PublishedDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="py-3 align-middle text-center text-secondary">
                                    <i class="far fa-eye me-1"></i> @post.ViewCount
                                </td>
                                <td class="py-3 px-4 align-middle text-end">
                                    <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary rounded-circle me-1" title="Edit" style="width:32px; height:32px; padding:0; line-height:30px;">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@post.Id" class="btn btn-sm btn-outline-danger rounded-circle" title="Delete" style="width:32px; height:32px; padding:0; line-height:30px;">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
