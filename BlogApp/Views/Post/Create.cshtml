@model BlogApp.Models.ViewModels.PostViewModel

@{
    ViewData["Title"] = "Create Post";
    bool isAdmin = User.IsInRole("Admin");
}
<style>
    .content-wrapper {
        padding: 20px;
        max-width: 1000px;
        margin: 0 auto;
        font-family: 'Inter', sans-serif;
    }
</style>
<div class="content-wrapper">
    <div class="row align-items-center mb-4">
        <div class="col-6">
            <h2 class="fw-bold m-0">@ViewData["Title"]</h2>
        </div>
        <div class="col-6 text-end">
            <a class="btn btn-outline-secondary" asp-action="@(isAdmin ? "Index" : "MyBlogs")" asp-controller="Post">
                <i class="fas fa-arrow-left me-1"></i> Back To List
            </a>
        </div>
    </div>
    
    <div class="card glass-card p-4 border-0">
        <form asp-action="Create" asp-controller="Post" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Post.Title" class="form-label fw-bold"></label>
                <input asp-for="Post.Title" class="form-control" />
                <span asp-validation-for="Post.Title" class="text-danger"></span>
            </div> 

            <div class="form-group mb-3">
                <label asp-for="Post.Category" class="form-label fw-bold"></label>
                <select asp-for="Post.CategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="">Select Category</option>
                </select>
                <span asp-validation-for="Post.CategoryId" class="text-danger"></span>
            </div>
            
            <input type="hidden" asp-for="Post.Author" value="Hidden" />

            <div class="form-group mb-3">
                <label asp-for="Post.Content" class="form-label fw-bold"></label>
                <textarea asp-for="Post.Content" class="form-control" rows="12"></textarea>
                <span asp-validation-for="Post.Content" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="FeatureImage" class="form-label fw-bold"></label>
                <input asp-for="FeatureImage" class="form-control" type="file" />
            </div>
            
            <div class="d-flex gap-2">
                @if (isAdmin)
                {
                    <button type="submit" name="submitAction" value="Publish" class="btn btn-primary px-4">
                        <i class="fas fa-paper-plane me-1"></i> Publish
                    </button>
                }
                else
                {
                    <button type="submit" name="submitAction" value="Draft" class="btn btn-secondary px-4">
                        <i class="fas fa-save me-1"></i> Save as Draft
                    </button>
                    <button type="submit" name="submitAction" value="Submit for Review" class="btn btn-primary px-4">
                        <i class="fas fa-paper-plane me-1"></i> Submit for Review
                    </button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/6a3cyosgsnqk14ob0unncbyn8k8q0t4cipo3uu83mefda18y/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
    <script>
        tinymce.init({
          selector: 'textarea',
          skin: "oxide-dark",
          content_css: "dark",
          plugins: 'lists link image table code',
          toolbar: 'undo redo | formatselect | bold italic | alignleft aligncenter alignright | bullist numlist outdent indent | link code'
        });
    </script>
}
