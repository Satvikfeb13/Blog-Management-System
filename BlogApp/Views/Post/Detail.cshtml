@model Post
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = Model.Title;
}

<style>
    .progress-container {
        width: 100%;
        height: 5px;
        background: transparent;
        position: fixed;
        top: 60px; /* Adjust based on navbar height */
        left: 0;
        z-index: 1030;
    }

    .progress-bar {
        height: 5px;
        background: var(--primary-color);
        width: 0%;
    }

    .post-content {
        font-size: 1.1rem;
        line-height: 1.8;
    }
    
    .post-content img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 20px 0;
    }
    
    .author-card {
        background: rgba(99, 102, 241, 0.05);
        border: 1px solid rgba(99, 102, 241, 0.1);
        border-radius: 12px;
    }
</style>

<div class="progress-container">
    <div class="progress-bar" id="myBar"></div>
</div>

<!-- Article Header -->
<div class="container mt-5 pt-3" data-aos="fade-in">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="mb-4">
                <a asp-controller="Post" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="badge badge-tag px-3 py-2 rounded-pill text-decoration-none mb-3">
                    <i class="fas fa-folder me-1"></i> @Model.Category?.Name
                </a>
                <h1 class="display-4 fw-bold" style="line-height: 1.2;">@Model.Title</h1>
                
                <div class="d-flex align-items-center mt-4 text-muted">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; font-size: 1.2rem;">
                        @Model.Author.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <div class="fw-bold" style="color: var(--text);">@Model.Author</div>
                        <div class="small">
                            <span>@Model.PublishedDate.ToString("MMMM dd, yyyy")</span>
                            <span class="mx-2">&middot;</span>
                            <span>@(Model.ReadTime > 0 ? Model.ReadTime : 5) min read</span>
                            <span class="mx-2">&middot;</span>
                            <span><i class="far fa-eye me-1"></i> @Model.ViewCount views</span>
                        </div>
                    </div>
                </div>
            </div>
            
            @if (User.IsInRole("Admin"))
            {
                <div class="mb-4 glass-card p-3 rounded d-flex align-items-center gap-2">
                    <span class="fw-bold me-2 align-self-center">Admin Actions:</span>
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Post" asp-action="Edit" asp-route-id="@Model.Id"><i class="fas fa-edit me-1"></i>Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-controller="Post" asp-action="Delete" asp-route-id="@Model.Id"><i class="fas fa-trash me-1"></i>Delete</a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Feature Image -->
<div class="container-fluid px-0 my-4" data-aos="fade-up">
    <img src="@(string.IsNullOrEmpty(Model.FeatureImagePath) ? "/images/default-blog.jpg" : Model.FeatureImagePath)"
         alt="@Model.Title"
         class="w-100"
         style="height: 60vh; object-fit: cover;" />
</div>

<!-- Article Content -->
<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="post-content glass-card p-4 p-md-5 mb-5" data-aos="fade-up">
                @Html.Raw(Model.Content)
            </div>
            
            <!-- Share & Tags -->
            <div class="d-flex justify-content-between align-items-center border-top border-bottom py-3 mb-5">
                <!-- Share options removed -->
                <div>
                    <button class="btn btn-outline-danger rounded-pill px-4"><i class="far fa-heart me-1"></i> Like</button>
                </div>
            </div>

            <!-- Author Info -->
            <div class="author-card p-4 mb-5 d-flex align-items-center gap-4" data-aos="fade-up">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 80px; height: 80px; font-size: 2rem;">
                    @Model.Author.Substring(0, 1).ToUpper()
                </div>
                <div>
                    <h5 class="fw-bold mb-1" style="color: var(--text);">Written by @Model.Author</h5>
                    <p class="text-muted mb-0">Contributing writer for BlogApp, sharing insights and stories on various topics.</p>
                </div>
            </div>

            <!-- Comments Section -->
            <div class="comments-wrapper" id="comments">
                <h3 class="fw-bold mb-4">Comments (@Model.Comments.Count)</h3>
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="card glass-card mb-5 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h5 class="mb-3">Leave a Reply</h5>
                            <form id="commentForm">
                                <input type="hidden" id="Username" value="@(User.Identity.Name)" />
                                <div class="mb-3">
                                    <textarea id="Content" name="Content" rows="3" required class="form-control" placeholder="What are your thoughts?"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary px-4 rounded-pill">Post Comment</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info rounded-3 mb-5 d-flex align-items-center">
                        <i class="fas fa-info-circle fs-4 me-3"></i>
                        <div>Please <a asp-controller="Auth" asp-action="Login" class="alert-link fw-bold">Login</a> to leave a comment.</div>
                    </div>
                }

                <div class="commentssection">
                    @if (Model.Comments.Any())
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var currentUserId = currentUser?.Id;
                        bool isAdmin = User.IsInRole("Admin");

                        @foreach (var comment in Model.Comments.OrderByDescending(c => c.CommentDate))
                        {
                            if (comment.IsHidden && !isAdmin) continue;

                            <div class="d-flex mb-4 p-3 glass-card border-0 rounded-3 shadow-sm comment-item @(comment.IsHidden ? "opacity-50" : "")">
                                <div class="me-3 flex-shrink-0">
                                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                        @comment.UserName.Substring(0, 1).ToUpper()
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div>
                                            <h6 class="fw-bold mb-0 d-inline-block">@comment.UserName</h6>
                                            @if (comment.IsHidden)
                                            {
                                                <span class="badge bg-secondary ms-2 small">Hidden</span>
                                            }
                                        </div>
                                        <div class="d-flex align-items-center gap-3">
                                            <small class="text-muted">@comment.CommentDate.ToString("MMM dd, yyyy")</small>
                                            
                                            @if (User.Identity?.IsAuthenticated == true)
                                            {
                                                <div class="dropdown">
                                                    <a href="#" class="text-muted text-decoration-none" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></a>
                                                    <ul class="dropdown-menu dropdown-menu-end glass-card">
                                                        @if (isAdmin || currentUserId == comment.CreatedByUserId)
                                                        {
                                                            <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deleteComment(@comment.Id)"><i class="fas fa-trash me-2"></i>Delete</a></li>
                                                        }
                                                        @if (currentUserId != comment.CreatedByUserId)
                                                        {
                                                            <li><a class="dropdown-item" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#reportModal-@comment.Id"><i class="fas fa-flag me-2"></i>Report</a></li>
                                                        }
                                                    </ul>
                                                </div>
                                                
                                                @if (currentUserId != comment.CreatedByUserId)
                                                {
                                                    <!-- Report Modal -->
                                                    <div class="modal fade" id="reportModal-@comment.Id" tabindex="-1">
                                                        <div class="modal-dialog modal-dialog-centered">
                                                            <div class="modal-content glass-card">
                                                                <div class="modal-header border-bottom border-light border-opacity-10">
                                                                    <h5 class="modal-title">Report Comment</h5>
                                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <form onsubmit="reportComment(event, @comment.Id)">
                                                                        <div class="mb-3">
                                                                            <label class="form-label">Reason</label>
                                                                            <select class="form-select" id="reason-@comment.Id" required>
                                                                                <option value="0">Spam</option>
                                                                                <option value="1">Abuse</option>
                                                                                <option value="2">Offensive Language</option>
                                                                                <option value="3">Other</option>
                                                                            </select>
                                                                        </div>
                                                                        <div class="mb-3">
                                                                            <label class="form-label">Additional Details</label>
                                                                            <textarea class="form-control" id="details-@comment.Id" rows="2"></textarea>
                                                                        </div>
                                                                        <div class="text-end">
                                                                            <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                                            <button type="submit" class="btn btn-danger rounded-pill px-4">Submit Report</button>
                                                                        </div>
                                                                    </form>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <p class="mb-0 mt-2" style="color: var(--text);">@comment.Content</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div id="no-comments-msg" class="text-center text-muted py-4">
                            <i class="far fa-comments fs-1 mb-2"></i>
                            <p>No comments yet. Be the first to share your thoughts!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Reading Progress Bar
        window.onscroll = function() {
            var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            var scrolled = (winScroll / height) * 100;
            document.getElementById("myBar").style.width = scrolled + "%";
        };

        $(document).ready(function() {
            $('#commentForm').on('submit', function(event) {
                event.preventDefault();
                
                var $btn = $(this).find('button[type="submit"]');
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Posting...');

                var userName = $('#Username').val();
                var content = $('#Content').val();
                var postId = @Model.Id;

                $.ajax({
                    url: '@Url.Action("AddComment", "Post")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        UserName: userName,
                        Content: content,
                        PostId: postId
                    }),
                    success: function(response) {
                        $('#commentForm')[0].reset();
                        $btn.prop('disabled', false).text('Post Comment');
                        $('#no-comments-msg').hide();

                        var newCommentHtml = `
                            <div class="d-flex mb-4 p-3 glass-card border-0 rounded-3 shadow-sm comment-item" style="display:none;">
                                <div class="me-3 flex-shrink-0">
                                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                        ${response.username.substring(0, 1).toUpperCase()}
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold mb-0">${response.username}</h6>
                                        <small class="text-muted">${response.CommentDate}</small>
                                    </div>
                                    <p class="mb-0" style="color: var(--text);">${response.content}</p>
                                </div>
                            </div>
                        `;
                        
                        var $newComment = $(newCommentHtml);
                        $('.commentssection').prepend($newComment);
                        $newComment.slideDown();
                    },
                    error: function() {
                        alert('An error occurred while posting your comment.');
                        $btn.prop('disabled', false).text('Post Comment');
                    }
                });
            });
        });

        function deleteComment(id) {
            if(confirm("Are you sure you want to delete this comment?")) {
                $.post('/Post/DeleteComment/' + id, function() {
                    window.location.reload();
                });
            }
        }

        function reportComment(e, id) {
            e.preventDefault();
            var reason = $('#reason-' + id).val();
            var details = $('#details-' + id).val();
            
            $.post('/Post/ReportComment', { id: id, reason: reason, additionalDetails: details }, function() {
                alert('Thank you. The comment has been reported for review.');
                var modal = bootstrap.Modal.getInstance(document.getElementById('reportModal-' + id));
                modal.hide();
            });
        }
    </script>
}